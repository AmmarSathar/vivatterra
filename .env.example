# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.

# Resend API key (server-only). Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions are emailed.
CONTACT_TO=fabrizio@vivatterra.com

# Verified sender address. For testing you can use Resend's shared sender
# (onboarding@resend.dev) which only delivers to your own account email.
# In production, verify a domain and use e.g. "VivaTTerra <hello@vivatterra.com>".
CONTACT_FROM=VivaTTerra <onboarding@resend.dev>
